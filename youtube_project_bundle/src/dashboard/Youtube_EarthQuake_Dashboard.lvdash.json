{
  "datasets": [
    {
      "name": "a05551d0",
      "displayName": "EarthQuake Detail",
      "queryLines": [
        "select * from silver.earthquake_data_final"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    },
    {
      "name": "27563ca4",
      "displayName": "Magnitude_Type",
      "queryLines": [
        "select \r\n",
        "  magnitude_bucket,\r\n",
        "  count(*) as total_magnitude_bucket\r\n",
        "from \r\n",
        "(\r\n",
        "  select \r\n",
        "    CASE\r\n",
        "      WHEN mag < 2 THEN 'Micro (<2)'\r\n",
        "      WHEN mag BETWEEN 2 AND 3 THEN 'Minor (2-3)'\r\n",
        "      WHEN mag BETWEEN 3 AND 4 THEN 'Light (3-4)'\r\n",
        "      ELSE 'Moderate+ (4+)'\r\n",
        "    END AS magnitude_bucket\r\n",
        "  from silver.earthquake_data_final\r\n",
        ")\r\n",
        "group by magnitude_bucket"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    },
    {
      "name": "1f553ab6",
      "displayName": "country",
      "queryLines": [
        "SELECT \r\n",
        "  count(*) AS event_count,\r\n",
        "  CASE \r\n",
        "    WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0]\r\n",
        "    ELSE split(place, ', ')[1]\r\n",
        "  END AS country\r\n",
        "FROM (\r\n",
        "  SELECT \r\n",
        "    time,\r\n",
        "    title,\r\n",
        "    mag,\r\n",
        "    longitude,\r\n",
        "    place,\r\n",
        "    latitude\r\n",
        "  FROM silver.earthquake_data_final\r\n",
        ")\r\n",
        "GROUP BY \r\n",
        "  CASE \r\n",
        "    WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0]\r\n",
        "    ELSE split(place, ', ')[1]\r\n",
        "  END"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    }
  ],
